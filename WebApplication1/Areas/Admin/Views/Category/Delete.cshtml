@model WebApplication1.Models.Category

@{
    ViewData["Title"] = "Delete Category";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1>Delete Category</h1>

<h3>Are you sure you want to delete this category?</h3>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@(Model.Description ?? "-")</dd>

            <dt class="col-sm-4">Parent Category</dt>
            <dd class="col-sm-8">@(Model.Parent?.Name ?? "None (Parent Category)")</dd>

            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">
                @if (Model.ParentId == null)
                {
                    <span class="badge bg-primary">Parent Category</span>
                }
                else
                {
                    <span class="badge bg-secondary">Child Category</span>
                }
            </dd>

            @if (Model.Children?.Any() == true)
            {
                <dt class="col-sm-4">Subcategories</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-warning text-dark">@Model.Children.Count subcategories</span>
                    <div class="text-danger mt-1">
                        <small><i class="fas fa-exclamation-triangle"></i> Cannot delete - has subcategories!</small>
                    </div>
                </dd>
            }

            @if (Model.Products?.Any() == true)
            {
                <dt class="col-sm-4">Products</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-warning text-dark">@Model.Products.Count products</span>
                    <div class="text-danger mt-1">
                        <small><i class="fas fa-exclamation-triangle"></i> Cannot delete - has products!</small>
                    </div>
                </dd>
            }
        </dl>
    </div>
</div>

<form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    
    @if (Model.Children?.Any() == true || Model.Products?.Any() == true)
    {
        <button type="submit" class="btn btn-danger" disabled>Delete (Not Allowed)</button>
    }
    else
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }
    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
