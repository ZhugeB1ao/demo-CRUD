@model List<WebApplication1.Models.Category>

<div class="apple-category-sidebar">
    @foreach (var cat in Model.Where(c => c.ParentId == null))
    {
        <div class="apple-category-group">
            <h3 class="apple-category-title">
                <a asp-controller="Product" asp-action="ListPro" asp-route-id="@cat.Id" style="text-decoration: none; color: inherit;">@cat.Name</a>
            </h3>
            @if (Model.Any(s => s.ParentId == cat.Id))
            {
                <ul class="apple-category-list apple-category-sublist">
                    @foreach (var sub in Model.Where(s => s.ParentId == cat.Id))
                    {
                        <li class="apple-category-item">
                            <a asp-controller="Product" asp-action="ListPro" asp-route-id="@sub.Id" class="apple-category-link">@sub.Name</a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>