@using Microsoft.AspNetCore.Identity
@using WebApplication1.Data.Entities

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager 

@if (SignInManager.IsSignedIn(User))
{
    <span style="opacity: 0.8;">@UserManager.GetUserName(User)</span>
    <span>|</span>
    <a asp-area="" asp-action="Logout" asp-controller="User" style="color: white; text-decoration: none; opacity: 0.8;">Logout</a>
}
else
{ 
    <a asp-area="" asp-action="Register" asp-controller="User" style="color: white; text-decoration: none; opacity: 0.8;">Register</a>
    <span>|</span>
    <a asp-area="" asp-action="Login" asp-controller="User" style="color: white; text-decoration: none; opacity: 0.8;">Login</a>
}