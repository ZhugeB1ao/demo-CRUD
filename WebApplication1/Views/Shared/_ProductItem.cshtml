@model WebApplication1.Models.Product

<div class="col-sm-6 col-md-6 col-lg-4 mb-4">
    <div class="apple-product-card">
        <a href="/Product/Detail/@Model.Id" class="apple-product-image-wrapper">
            <img class="apple-product-image" src="@Model.Picture" alt="@Model.Name">
        </a>
        <div class="apple-product-info">
            <a href="/Product/Detail/@Model.Id" class="apple-product-name">@Model.Name</a>
            <div class="apple-product-price">$@Model.Price</div>
            <div class="apple-product-actions">
                <a href="/Product/Detail/@Model.Id" class="apple-btn apple-btn-primary" style="flex: 1; text-align: center;">View Details</a>
            </div>
        </div>
    </div>
</div>
