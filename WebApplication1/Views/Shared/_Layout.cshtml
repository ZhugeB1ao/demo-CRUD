<!DOCTYPE html>
<html lang="en">
	<head>
	    <title>PhoneStore - Premium Smartphones</title>
	    <meta charset="utf-8">
	    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	    
	    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
	    <link rel="stylesheet" href="~/assets/css/ionicons.min.css">
	    <link rel="stylesheet" href="~/assets/css/icomoon.css">
	    <link rel="stylesheet" href="~/assets/css/apple-style.css">
	</head>
	<body>
		<!-- Top Bar -->
		<div class="apple-top-bar">
			<div class="container">
				<div class="row align-items-center">
					<div class="col-md-8 d-flex align-items-center" style="gap: 24px; font-size: 12px;">
						<span>Free shipping on orders over $50</span>
						<span>|</span>
						<span>Support: 0949455439</span>
					</div>
					<div class="col-md-4 d-flex justify-content-end align-items-center" style="gap: 8px;">
						@await Html.PartialAsync("_LoginPartial")
					</div>
				</div>
			</div>
		</div>

		<!-- Main Navigation -->
		<nav class="apple-nav">
			<div class="container">
				<div class="navbar navbar-expand-lg navbar-light py-3">
					<a class="apple-nav-brand" asp-controller="Shop">ĐT Shop</a>
					<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNav">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="mainNav">
						<ul class="navbar-nav ml-auto align-items-center">
							<li class="nav-item">
								<a class="apple-nav-link" asp-controller="Shop" asp-action="Index">Shop</a>
							</li>
							<li class="nav-item">
								<a class="apple-nav-link" asp-controller="Cart" asp-action="Index">
									<span class="icon-shopping_cart"></span> Cart
								</a>
							</li>
							@if (User.Identity?.IsAuthenticated == true)
							{
								<li class="nav-item">
									<a class="apple-nav-link" href="#" data-toggle="modal" data-target="#paymentHistoryModal" title="Payment History">
										<span class="icon-history" style="font-size: 18px;"></span>
									</a>
								</li>
							}
						</ul>
					</div>
				</div>
			</div>
		</nav>

		@RenderBody()

		<!-- Footer -->
		<footer class="apple-footer">
			<div class="container">
				<div class="row">
					<div class="col-md-3 apple-footer-section">
						<h3 class="apple-footer-title">DT Shop</h3>
						<p class="apple-text-secondary">Premium smartphones for everyone.</p>
					</div>
					<div class="col-md-3 apple-footer-section">
						<h3 class="apple-footer-title">Shop</h3>
						<a asp-controller="Shop" asp-action="Index" class="apple-footer-link">All Products</a>
						<a href="#" class="apple-footer-link">New Arrivals</a>
						<a href="#" class="apple-footer-link">Best Sellers</a>
					</div>
					<div class="col-md-3 apple-footer-section">
						<h3 class="apple-footer-title">Support</h3>
						<a href="#" class="apple-footer-link">Contact Us</a>
						<a href="#" class="apple-footer-link">Shipping Info</a>
						<a href="#" class="apple-footer-link">Returns</a>
						<a href="#" class="apple-footer-link">FAQ</a>
					</div>
					<div class="col-md-3 apple-footer-section">
						<h3 class="apple-footer-title">Connect</h3>
						<a href="#" class="apple-footer-link">Facebook</a>
						<a href="#" class="apple-footer-link">Twitter</a>
						<a href="#" class="apple-footer-link">Instagram</a>
					</div>
				</div>
				<div class="apple-footer-bottom">
					<p>&copy; <script>document.write(new Date().getFullYear());</script> PhoneStore. All rights reserved.</p>
				</div>
			</div>
		</footer>

		<script src="~/assets/js/jquery.min.js"></script>
		<script src="~/assets/js/popper.min.js"></script>
		<script src="~/assets/js/bootstrap.min.js"></script>

		<!-- Payment History Modal -->
		<div class="modal fade" id="paymentHistoryModal" tabindex="-1" role="dialog" aria-labelledby="paymentHistoryLabel" aria-hidden="true">
			<div class="modal-dialog modal-lg" role="document">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="paymentHistoryLabel">
							<i class="icon-history"></i> Payment History
						</h5>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">&times;</span>
						</button>
					</div>
					<div class="modal-body" id="paymentHistoryContent">
						<div class="text-center" style="padding: 20px;">
							<div class="spinner-border" role="status">
								<span class="sr-only">Loading...</span>
							</div>
							<p>Loading your payment history...</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
			// Load payment history when modal is shown
			document.addEventListener('DOMContentLoaded', function() {
				var modal = document.getElementById('paymentHistoryModal');
				if (modal) {
					// Use Bootstrap 4 event: show.bs.modal
					$(modal).on('show.bs.modal', function() {
						fetch('/Cart/PaymentHistory')
							.then(response => {
								if (!response.ok) {
									throw new Error('Network response was not ok: ' + response.statusText);
								}
								return response.text();
							})
							.then(html => {
								document.getElementById('paymentHistoryContent').innerHTML = html;
							})
							.catch(error => {
								console.error('Error:', error);
								document.getElementById('paymentHistoryContent').innerHTML = '<p class="text-danger">Error loading payment history. Please try again.</p>';
							});
					});
				}
			});
		</script>
		    <!-- Success Popup -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="apple-popup-overlay" id="successPopup">
            <div class="apple-popup">
                <div class="apple-popup-icon">
                    <i class="ion-ios-checkmark"></i>
                </div>
                <h3 class="apple-popup-title">Success</h3>
                <p class="apple-popup-message">@TempData["SuccessMessage"]</p>
                <button class="apple-popup-btn" onclick="closePopup()">Continue Shopping</button>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var popup = document.getElementById('successPopup');
                setTimeout(function() {
                    popup.classList.add('show');
                }, 100);
            });

            function closePopup() {
                var popup = document.getElementById('successPopup');
                popup.classList.remove('show');
                setTimeout(function() {
                    popup.remove();
                }, 300);
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>