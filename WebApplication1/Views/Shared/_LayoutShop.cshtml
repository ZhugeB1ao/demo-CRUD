@{
    Layout = "_Layout";
}

<div style="background-color: white; padding: 40px 0; border-bottom: 1px solid #d2d2d7;">
    <div class="container">
        <p class="apple-breadcrumb">
            <a asp-controller="Shop" asp-action="Index">Home</a> / Products
        </p>
        <h1 class="apple-heading-2">Our Collection</h1>
    </div>
</div>

<section class="apple-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 order-lg-last">
                @RenderBody()   
            </div>

            <div class="col-lg-2">
                @await Component.InvokeAsync("Category")
            </div>
        </div>
    </div>
</section>
