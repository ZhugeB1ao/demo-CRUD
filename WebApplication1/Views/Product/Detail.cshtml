@model WebApplication1.Models.Product

<section class="apple-section" style="padding-top: 40px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <img src="@Model.Picture" class="apple-product-detail-image" alt="@Model.Name">
            </div>
            <div class="col-lg-6">
                <div class="apple-product-detail-info">
                    <h1 class="apple-heading-1">@Model.Name</h1>
                    <div class="apple-product-price" style="margin-bottom: 24px;">$@Model.Price</div>
                    
                    <p class="apple-text-secondary" style="margin-bottom: 32px;">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <text>Experience the latest in smartphone technology with premium features and elegant design.</text>
                        }
                    </p>

                    <div style="margin-bottom: 24px;">
                        <label class="apple-form-label">Storage</label>
                        <select class="apple-form-select">
                            <option>128GB</option>
                            <option>256GB</option>
                            <option>512GB</option>
                            <option>1TB</option>
                        </select>
                    </div>

                    <form asp-controller="Cart" asp-action="AddToCart" method="post" id="addToCartForm">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        
                        <div class="d-flex" style="gap: 16px;">
                            <button type="submit" class="apple-btn apple-btn-primary" style="flex: 1; padding: 16px; font-size: 17px;">Add to Cart</button>
                            <a href="#" class="apple-btn apple-btn-secondary" style="padding: 16px 24px;">
                                <i class="ion-ios-heart-outline"></i>
                            </a>
                        </div>
                    </form>



                    <div style="margin-top: 40px; padding-top: 40px; border-top: 1px solid #d2d2d7;">
                        <h3 class="apple-heading-3">Features</h3>
                        <ul style="color: #6e6e73; line-height: 1.8;">
                            <li>Premium build quality</li>
                            <li>Advanced camera system</li>
                            <li>All-day battery life</li>
                            <li>Fast wireless charging</li>
                            <li>Water and dust resistant</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
