@model WebApplication1.ViewModels.RegisterViewModel

<div class="apple-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div style="background-color: #f5f5f7; padding: 48px; border-radius: 18px;">
                    <h2 class="apple-heading-2" style="text-align: center; margin-bottom: 32px;">Create Account</h2>
                    
                    <form id="registerForm" asp-action="Register" asp-controller="User" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 24px; padding: 12px; background-color: #fff; border-radius: 8px;"></div>
                        
                        <div class="apple-form-group">
                            <label asp-for="Email" class="apple-form-label">Email</label>
                            <input asp-for="Email" class="apple-form-input" autocomplete="username" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <div class="apple-form-group">
                            <label asp-for="FullName" class="apple-form-label">Full Name</label>
                            <input asp-for="FullName" class="apple-form-input" placeholder="John Doe" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <div class="apple-form-group">
                            <label asp-for="Phone" class="apple-form-label">Phone</label>
                            <input asp-for="Phone" class="apple-form-input" placeholder="+1 (555) 123-4567" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <div class="apple-form-group">
                            <label asp-for="Address" class="apple-form-label">Address</label>
                            <input asp-for="Address" class="apple-form-input" placeholder="123 Main St, City, State" />
                            <span asp-validation-for="Address" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <div class="apple-form-group">
                            <label asp-for="Password" class="apple-form-label">Password</label>
                            <input asp-for="Password" class="apple-form-input" autocomplete="new-password" placeholder="Create a strong password" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 14px;"></span>
                        </div>

                        <div class="apple-form-group">
                            <label asp-for="ConfirmPassword" class="apple-form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="apple-form-input" autocomplete="new-password" placeholder="Confirm your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <button id="registerSubmit" type="submit" class="apple-btn apple-btn-primary" style="width: 100%; padding: 16px; font-size: 17px; margin-top: 8px;">Create Account</button>
                        
                        <div style="text-align: center; margin-top: 24px;">
                            <p style="color: #6e6e73; font-size: 14px;">
                                Already have an account? 
                                <a asp-action="Login" asp-controller="User" style="color: #0071e3; text-decoration: none;">Sign in</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
