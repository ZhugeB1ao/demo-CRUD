@model WebApplication1.ViewModels.LoginViewModel;

<div class="apple-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div style="background-color: #f5f5f7; padding: 48px; border-radius: 18px;">
                    <h2 class="apple-heading-2" style="text-align: center; margin-bottom: 32px;">Sign In</h2>
                    
                    <form id="account" method="post" asp-action="Login" asp-controller="User">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" style="margin-bottom: 24px; padding: 12px; background-color: #fff; border-radius: 8px;"></div>
                        
                        <div class="apple-form-group">
                            <label asp-for="@Model.Email" class="apple-form-label">Email</label>
                            <input asp-for="@Model.Email" class="apple-form-input" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                            <span asp-validation-for="@Model.Email" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                        
                        <div class="apple-form-group">
                            <label asp-for="@Model.Password" class="apple-form-label">Password</label>
                            <input asp-for="@Model.Password" class="apple-form-input" autocomplete="current-password" aria-required="true" placeholder="Enter your password"/>
                            <span asp-validation-for="@Model.Password" class="text-danger" style="font-size: 14px;"></span>
                        </div>
                      
                        <button id="login-submit" type="submit" class="apple-btn apple-btn-primary" style="width: 100%; padding: 16px; font-size: 17px; margin-top: 8px;">Sign In</button>
                        
                        <div style="text-align: center; margin-top: 24px;">
                            <p style="color: #6e6e73; font-size: 14px;">
                                Don't have an account? 
                                <a asp-action="Register" asp-controller="User" asp-route-returnUrl="" style="color: #0071e3; text-decoration: none;">Create one now</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
