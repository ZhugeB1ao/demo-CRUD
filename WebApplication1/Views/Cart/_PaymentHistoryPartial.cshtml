@using WebApplication1.Models
@model List<Order>

<div class="payment-history-container">
    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center" style="padding: 40px 20px;">
            <h5>No purchases yet</h5>
            <p class="text-secondary">Start shopping to build your purchase history!</p>
        </div>
    }
    else
    {
        <div class="payment-history-table">
            <table class="table table-hover" style="margin-bottom: 0;">
                <thead class="table-light">
                    <tr>
                        <th>Order Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        var itemCount = order.OrderProducts?.Count ?? 0;
                        <tr style="cursor: pointer;" data-order-id="@order.Id" onclick="toggleOrderDetails(@order.Id)">
                            <td>
                                <strong>@order.CreatedAt?.ToString("MMM dd, yyyy")</strong>
                            </td>
                            <td>
                                @itemCount item@(itemCount > 1 ? "s" : "")
                            </td>
                            <td>
                                <strong style="font-size: 16px;">$@order.Total.ToString("F2")</strong>
                            </td>
                            <td>
                                @{
                                    string statusClass = order.Status switch
                                    {
                                        "Pending" => "warning",
                                        "Paid" => "success",
                                        "Shipped" => "primary",
                                        "Delivered" => "info",
                                        "Cancelled" => "danger",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge badge-@statusClass">@order.Status</span>
                            </td>
                        </tr>
                        <!-- Order Details Row -->
                        <tr id="order-details-@order.Id" style="display: none;">
                            <td colspan="4" style="padding: 20px; background-color: #f8f9fa;">
                                <div>
                                    <h6 style="margin-bottom: 16px;">Order Items:</h6>
                                    <div style="background: white; border-radius: 8px; padding: 16px; border: 1px solid #e5e5e7;">
                                        @if (order.OrderProducts != null && order.OrderProducts.Any())
                                        {
                                            <ul style="margin: 0; padding: 0; list-style: none;">
                                                @foreach (var item in order.OrderProducts)
                                                {
                                                    var product = item.Product;
                                                    var subtotal = (product?.Price ?? 0) * (item.Quantity ?? 1);
                                                    <li style="padding: 12px 0; border-bottom: 1px solid #e5e5e7; display: flex; justify-content: space-between; align-items: center;">
                                                        <div style="flex: 1;">
                                                            <strong>@product?.Name</strong>
                                                            <br>
                                                            <small class="text-secondary">Qty: @item.Quantity × $@product?.Price.ToString("F2")</small>
                                                        </div>
                                                        <div style="text-align: right; margin-left: 16px;">
                                                            <strong>$@subtotal.ToString("F2")</strong>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <script>
            function toggleOrderDetails(orderId) {
                var detailsRow = document.getElementById('order-details-' + orderId);
                if (detailsRow) {
                    detailsRow.style.display = detailsRow.style.display === 'none' ? 'table-row' : 'none';
                }
            }
        </script>

        <style>
            .payment-history-table {
                border-radius: 8px;
                overflow: hidden;
                border: 1px solid #e5e5e7;
            }

            .payment-history-table table tr:hover {
                background-color: #f5f5f7 !important;
            }

            .payment-history-table table tbody tr {
                cursor: pointer;
            }

            .badge-Pending {
                background-color: #ffc107;
                color: #000;
            }

            .badge-Paid {
                background-color: #28a745;
                color: white;
            }

            .badge-Shipped {
                background-color: #0077cc;
                color: white;
            }

            .badge-Delivered {
                background-color: #20c997;
                color: white;
            }

            .badge-Cancelled {
                background-color: #dc3545;
                color: white;
            }
        </style>
    }
</div>
