@using WebApplication1.Models
@model Order

<div style="background-color: white; padding: 40px 0; border-bottom: 1px solid #d2d2d7;">
    <div class="container">
        <p class="apple-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a> / Cart
        </p>
        <h1 class="apple-heading-2">Shopping Cart</h1>
    </div>
</div>

<section class="apple-section">
    <div class="container">
        @if (Model.OrderProducts == null || !Model.OrderProducts.Any())
        {
            <div class="text-center" style="padding: 80px 0;">
                <h3 class="apple-heading-3">Your cart is empty</h3>
                <p class="apple-text-secondary" style="margin-bottom: 32px;">Add some products to get started!</p>
                <a asp-controller="Shop" asp-action="Index" class="apple-btn apple-btn-primary">Continue Shopping</a>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <table class="apple-cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderProducts)
                            {
                                var product = item.Product;
                                
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap: 16px;">
                                            <img class="apple-cart-image" src="@(product?.Picture ?? "/images/placeholder.svg")" alt="@product?.Name" onerror="this.onerror=null; this.src='/images/placeholder.svg';">
                                            <div>
                                                <h4 style="font-size: 17px; font-weight: 600; margin: 0;">@product?.Name</h4>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="font-weight: 600;">$@product?.Price</td>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap: 8px;">
                                            <form asp-controller="Cart" asp-action="DecrementQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="apple-quantity-btn">-</button>
                                            </form>
                                            <span style="min-width: 40px; text-align: center; font-weight: 600;">@item.Quantity</span>
                                            <form asp-controller="Cart" asp-action="IncrementQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="apple-quantity-btn">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td style="font-weight: 600;">$@((product?.Price ?? 0) * (item.Quantity ?? 0))</td>
                                    <td>
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" style="background: none; border: none; color: #6e6e73; cursor: pointer;">
                                                <span class="ion-ios-close" style="font-size: 24px;"></span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="col-lg-4">
                    @{
                        var subtotal = Model.OrderProducts.Sum(item => {
                            return (item.Product?.Price ?? 0) * (item.Quantity ?? 0);
                        });
                        var tax = subtotal * 0.1m;
                        var total = subtotal + tax;
                    }
                    
                    <div class="apple-cart-total">
                        <h3 class="apple-heading-3">Order Summary</h3>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <span style="font-weight: 600;">$@subtotal</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Shipping</span>
                            <span style="font-weight: 600;">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax (10%)</span>
                            <span style="font-weight: 600;">$@tax</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span style="font-size: 21px; font-weight: 600;">Total</span>
                            <span style="font-size: 21px; font-weight: 600;">$@total</span>
                            @* <span style="font-size: 21px; font-weight: 600;">$0.00</span> *@
                        </div>
                        <button type="button" id="checkoutBtn" class="apple-btn apple-btn-primary" style="width: 100%; padding: 16px; border: none; cursor: pointer;">
                            <i class="fas fa-credit-card"></i> Checkout
                        </button>
                        <a asp-controller="Shop" asp-action="Index" class="apple-btn apple-btn-text" style="width: 100%; display: block; margin-top: 16px; text-align: center;">Continue Shopping</a>
                        
                        <form asp-controller="Cart" asp-action="ClearCart" method="post" style="margin-top: 16px;">
                            <button type="submit" class="apple-btn apple-btn-text" style="width: 100%; color: #ff3b30;">Clear Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Checkout Success Modal -->
<div class="modal fade" id="checkoutSuccessModal" tabindex="-1" role="dialog" aria-labelledby="checkoutSuccessLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border: none; border-radius: 18px; overflow: hidden;">
            <div class="modal-body text-center" style="padding: 48px 32px;">
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #34c759 0%, #30d158 100%); border-radius: 50%; margin: 0 auto 24px; display: flex; align-items: center; justify-content: center; animation: scaleIn 0.3s ease-out;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h3 style="font-size: 28px; font-weight: 700; margin-bottom: 16px; color: #1d1d1f;">Payment Successful!</h3>
                <p style="font-size: 17px; color: #6e6e73; margin-bottom: 8px;">Your order has been confirmed</p>
                <p style="font-size: 15px; color: #86868b; margin-bottom: 24px;">
                    <i class="ion-ios-location" style="margin-right: 4px;"></i>
                    Your items will be shipped to:<br>
                    <strong id="deliveryAddress" style="color: #1d1d1f; font-size: 16px;"></strong>
                </p>
                <div style="background: #f5f5f7; border-radius: 12px; padding: 16px; margin-bottom: 24px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #6e6e73;">Order ID:</span>
                        <strong id="orderIdDisplay" style="color: #1d1d1f;">#</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6e6e73;">Total Amount:</span>
                        <strong id="orderTotalDisplay" style="color: #1d1d1f; font-size: 18px;">$</strong>
                    </div>
                </div>
                <button type="button" class="apple-btn apple-btn-primary" onclick="window.location.href='@Url.Action("Index", "Shop")'" style="width: 100%; padding: 14px; border: none; cursor: pointer; margin-bottom: 12px;">
                    Continue Shopping
                </button>
                <button type="button" class="apple-btn apple-btn-text" data-dismiss="modal" style="width: 100%;">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
    
    .modal-content {
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkoutBtn = document.getElementById('checkoutBtn');
            
            if (checkoutBtn) {
                checkoutBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    // Disable button and show loading state
                    checkoutBtn.disabled = true;
                    checkoutBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
                    
                    // Send AJAX request
                    fetch('@Url.Action("Checkout", "Cart")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update modal with order details
                            document.getElementById('deliveryAddress').textContent = data.address;
                            document.getElementById('orderIdDisplay').textContent = '#' + data.orderId;
                            document.getElementById('orderTotalDisplay').textContent = '$' + data.orderTotal.toFixed(2);
                            
                            // Show success modal
                            $('#checkoutSuccessModal').modal('show');
                            
                            // Redirect to shop after modal is closed (use 'one' to ensure it only fires once)
                            $('#checkoutSuccessModal').one('hidden.bs.modal', function () {
                                window.location.href = '@Url.Action("Index", "Shop")';
                            });
                        } else {
                            // Show error message
                            alert(data.message || 'An error occurred during checkout');
                            
                            // Re-enable button
                            checkoutBtn.disabled = false;
                            checkoutBtn.innerHTML = '<i class="fas fa-credit-card"></i> Checkout';
                            
                            // Redirect to login if needed
                            if (data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                            }
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred during checkout. Please try again.');
                        
                        // Re-enable button
                        checkoutBtn.disabled = false;
                        checkoutBtn.innerHTML = '<i class="fas fa-credit-card"></i> Checkout';
                    });
                });
            }
        });
    </script>
}