@using WebApplication1.Models
@model Order

<div style="background-color: white; padding: 40px 0; border-bottom: 1px solid #d2d2d7;">
    <div class="container">
        <p class="apple-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a> / Cart
        </p>
        <h1 class="apple-heading-2">Shopping Cart</h1>
    </div>
</div>

<section class="apple-section">
    <div class="container">
        @if (Model.OrderProducts == null || !Model.OrderProducts.Any())
        {
            <div class="text-center" style="padding: 80px 0;">
                <h3 class="apple-heading-3">Your cart is empty</h3>
                <p class="apple-text-secondary" style="margin-bottom: 32px;">Add some products to get started!</p>
                <a asp-controller="Shop" asp-action="Index" class="apple-btn apple-btn-primary">Continue Shopping</a>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <table class="apple-cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderProducts)
                            {
                                var product = item.Product;
                                
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap: 16px;">
                                            <img class="apple-cart-image" src="@(product?.Picture ?? Url.Content("~/assets/images/product-3.jpg"))" alt="@product?.Name">
                                            <div>
                                                <h4 style="font-size: 17px; font-weight: 600; margin: 0;">@product?.Name</h4>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="font-weight: 600;">$@product?.Price</td>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap: 8px;">
                                            <form asp-controller="Cart" asp-action="DecrementQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="apple-quantity-btn">-</button>
                                            </form>
                                            <span style="min-width: 40px; text-align: center; font-weight: 600;">@item.Quantity</span>
                                            <form asp-controller="Cart" asp-action="IncrementQuantity" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="apple-quantity-btn">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td style="font-weight: 600;">$@((product?.Price ?? 0) * (item.Quantity ?? 0))</td>
                                    <td>
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" style="background: none; border: none; color: #6e6e73; cursor: pointer;">
                                                <span class="ion-ios-close" style="font-size: 24px;"></span>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="col-lg-4">
                    @{
                        var subtotal = Model.OrderProducts.Sum(item => {
                            return (item.Product?.Price ?? 0) * (item.Quantity ?? 0);
                        });
                        var tax = subtotal * 0.1m;
                        var total = subtotal + tax;
                    }
                    
                    <div class="apple-cart-total">
                        <h3 class="apple-heading-3">Order Summary</h3>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <span style="font-weight: 600;">$@subtotal</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Shipping</span>
                            <span style="font-weight: 600;">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax (10%)</span>
                            <span style="font-weight: 600;">$@tax</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span style="font-size: 21px; font-weight: 600;">Total</span>
                            <span style="font-size: 21px; font-weight: 600;">$@total</span>
                        </div>
                        <form asp-controller="Cart" asp-action="Checkout" method="post">
                            <button type="submit" class="apple-btn apple-btn-primary" style="width: 100%; padding: 16px; border: none; cursor: pointer;">
                                <i class="fas fa-credit-card"></i> Checkout
                            </button>
                        </form>
                        <a asp-controller="Shop" asp-action="Index" class="apple-btn apple-btn-text" style="width: 100%; display: block; margin-top: 16px; text-align: center;">Continue Shopping</a>
                        
                        <form asp-controller="Cart" asp-action="ClearCart" method="post" style="margin-top: 16px;">
                            <button type="submit" class="apple-btn apple-btn-text" style="width: 100%; color: #ff3b30;">Clear Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>